APP_NAME="Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shop
DB_USERNAME=shop_app
DB_PASSWORD=

# SQLite 로 되돌리려면 DB_CONNECTION=sqlite 한 줄만 바꾸면 된다.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# 상품 이미지 저장소. 로컬은 public, 운영은 s3.
# s3 로 바꾸려면 아래 AWS_* 를 채우고 다음을 설치한다:
#   composer require league/flysystem-aws-s3-v3
SHOP_IMAGE_DISK=public

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 상담 채널 (네이버 톡톡 · 카카오 채널 등). 비워두면 문의 버튼이 안 뜬다.
SHOP_SUPPORT_LABEL="톡톡 문의"
SHOP_SUPPORT_URL=

# 간편로그인 (카카오·네이버). 비워두면 로그인/가입 화면에 버튼이 안 뜬다.
# 각 개발자센터에서 앱을 등록하고 Redirect URI 로
#   {APP_URL}/login/kakao/callback
#   {APP_URL}/login/naver/callback
# 를 등록한 뒤 발급받은 값을 넣는다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
